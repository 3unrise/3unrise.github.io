@inproceedings{tan2023ccs,
  title = {SHERLOC: Secure and Holistic Control-Flow Violation Detection on Embedded Systems},
  author = {Tan, Xi and Zhao, Ziming},
  year = {2023},
  booktitle = {ACM SIGSAC Conference on Computer and Communications Security (CCS)},
  abbr = {CCS},
  venue_url = {https://www.sigsac.org/ccs/CCS2023/index.html},
  pdf = {https://dl.acm.org/doi/pdf/10.1145/3576915.3623077},
  code = {https://github.com/CactiLab/Sherloc-Cortex-M-CFVD},
  poster = {/assets/pdf/sherloc/sherloc2023-poster.pdf},
  slides = {/assets/pdf/sherloc/sherloc2023-slides.pdf},
  ae = {/assets/pdf/sherloc/sherloc2023-ae.pdf},
  abstract = {Microcontroller-based embedded systems are often programmed in low-level languages and are vulnerable to control-flow hijacking attacks. One approach to prevent such attacks is to enforce control-flow integrity (CFI), but inlined CFI enforcement can increase binary size and change memory layout. Sherloc is a secure and holistic control-flow violation detection mechanism for ARMv8-M embedded systems that monitors forward and backward edges across privileged and unprivileged components and handles interrupts and scheduling events securely and efficiently.}
}

@inproceedings{ma2023dac,
  title = {Return-to-Non-Secure Vulnerabilities on ARM Cortex-M TrustZone: Attack and Defense},
  author = {Ma, Zheyuan and Tan, Xi and Ziarek, Lukasz and Zhang, Ning and Hu, Hongxin and Zhao, Ziming},
  year = {2023},
  booktitle = {ACM/IEEE Design Automation Conference},
  abbr = {DAC},
  venue_url = {https://www.dac.com/About/Conference-Archive/60th-DAC-2023},
  pdf = {/assets/pdf/ret2ns/ret2ns2023.pdf},
  code = {https://github.com/CactiLab/ret2ns-Cortex-M-TrustZone},
  poster = {/assets/pdf/ret2ns/ret2ns2023-poster.pdf},
  slides = {/assets/pdf/ret2ns/ret2ns2023-slides.pdf},
  abstract = {Cortex-M TrustZone enables efficient secure/non-secure state switches, but this fast path can be abused. This paper presents return-to-non-secure (ret2ns), demonstrates four attack variants on real Cortex-M systems, and proposes lightweight address-sanitizing defenses with negligible overhead.}
}

